{
  "name": "ipeds-query-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "types": "./types/ds-entry.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "types": "tsc -p tsconfig.json",
    "typecheck": "rm -rf .types-check && tsc -p tsconfig.json --outDir .types-check && diff -r types .types-check",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.0",
    "sql-formatter": "^15.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
